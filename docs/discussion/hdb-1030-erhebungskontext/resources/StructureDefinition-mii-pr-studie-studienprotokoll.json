        "mustSupport": true
      },
      {
        "id": "PlanDefinition.version",
        "path": "PlanDefinition.version",
        "mustSupport": true
      },
      {
        "id": "PlanDefinition.name",
        "path": "PlanDefinition.name",
        "mustSupport": true
      },
      {
        "id": "PlanDefinition.title",
        "path": "PlanDefinition.title",
        "min": 1,
        "mustSupport": true
      },
      {
