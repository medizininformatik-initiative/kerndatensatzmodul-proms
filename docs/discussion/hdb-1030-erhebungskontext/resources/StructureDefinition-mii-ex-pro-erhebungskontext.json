{
  "resourceType": "StructureDefinition",
  "id": "mii-ex-pro-erhebungskontext",
  "url": "https://www.medizininformatik-initiative.de/fhir/ext/modul-pro/StructureDefinition/mii-ex-pro-erhebungskontext",
  "version": "0.1.0",
  "name": "MII_EX_PRO_Erhebungskontext",
  "title": "Erhebungskontext (Vorschlag HDB-1030)",
  "status": "draft",
  "experimental": true,
  "description": "VORSCHLAG aus dem Ballotkommentar HDB-1030 zum MII-Modul PRO, hier nur zur Illustration mitdefiniert. Beschreibt, welcher Punkt im Versorgungs- oder Studienverlauf eine QuestionnaireResponse bzw. Score-Observation ausgelöst hat. Zwei Modi: (a) Routine: triggerType + triggerDate; (b) Protokoll: protocol + protocolPosition, Indexdatum und Soll-Intervalle liegen dann auf ResearchSubject.period.start und in der PlanDefinition. Befüllung durch den Formular-Filler aus Launch-Context (%study, %encounter, %clinical) bzw. aus QuestionnaireResponse.basedOn, nie durch Patienteneingabe.",
  "fhirVersion": "4.0.1",
  "kind": "complex-type",
  "abstract": false,
  "context": [
    {
      "type": "element",
      "expression": "QuestionnaireResponse"
    },
    {
      "type": "element",
      "expression": "Observation"
    }
  ],
  "type": "Extension",
  "baseDefinition": "http://hl7.org/fhir/StructureDefinition/Extension",
  "derivation": "constraint",
  "differential": {
    "element": [
      {
        "id": "Extension",
        "path": "Extension",
        "short": "Erhebungskontext (Vorschlag HDB-1030)",
        "definition": "VORSCHLAG aus dem Ballotkommentar HDB-1030 zum MII-Modul PRO, hier nur zur Illustration mitdefiniert. Beschreibt, welcher Punkt im Versorgungs- oder Studienverlauf eine QuestionnaireResponse bzw. Score-Observation ausgelöst hat. Zwei Modi: (a) Routine: triggerType + triggerDate; (b) Protokoll: protocol + protocolPosition, Indexdatum und Soll-Intervalle liegen dann auf ResearchSubject.period.start und in der PlanDefinition. Befüllung durch den Formular-Filler aus Launch-Context (%study, %encounter, %clinical) bzw. aus QuestionnaireResponse.basedOn, nie durch Patienteneingabe.",
        "constraint": [
          {
            "key": "erhk-1",
            "severity": "error",
            "human": "Mindestens eines von Trigger-Ereignistyp (Routine) oder Protokollreferenz (Studie/Pfad) muss angegeben sein.",
            "expression": "extension.where(url = 'triggerType').exists() or extension.where(url = 'protocol').exists()",
            "source": "https://www.medizininformatik-initiative.de/fhir/ext/modul-pro/StructureDefinition/mii-ex-pro-erhebungskontext"
          }
        ]
      },
      {
        "id": "Extension.extension:triggerType",
        "path": "Extension.extension",
        "sliceName": "triggerType",
        "short": "Trigger-Ereignistyp (Baseline, Entlassung, Follow-up, prä-/postoperativ, on demand …)",
        "min": 0,
        "max": "1",
        "mustSupport": true
      },
      {
        "id": "Extension.extension:triggerType.extension",
        "path": "Extension.extension.extension",
        "max": "0"
      },
      {
        "id": "Extension.extension:triggerType.url",
        "path": "Extension.extension.url",
        "fixedUri": "triggerType"
      },
      {
        "id": "Extension.extension:triggerType.value[x]",
        "path": "Extension.extension.value[x]",
        "type": [
          {
            "code": "CodeableConcept"
          }
        ],
        "binding": {
          "strength": "extensible",
          "valueSet": "https://pcor-mii.de/fhir/ValueSet/pcor-vs-trigger-ereignis"
        }
      },
      {
        "id": "Extension.extension:triggerDate",
        "path": "Extension.extension",
        "sliceName": "triggerDate",
        "short": "Datum des auslösenden Ereignisses (OP, Entlassung …), nicht das Ausfülldatum",
        "min": 0,
        "max": "1",
        "mustSupport": true
      },
      {
        "id": "Extension.extension:triggerDate.extension",
        "path": "Extension.extension.extension",
        "max": "0"
      },
      {
        "id": "Extension.extension:triggerDate.url",
        "path": "Extension.extension.url",
        "fixedUri": "triggerDate"
      },
      {
        "id": "Extension.extension:triggerDate.value[x]",
        "path": "Extension.extension.value[x]",
        "type": [
          {
            "code": "date"
          }
        ]
      },
      {
        "id": "Extension.extension:protocol",
        "path": "Extension.extension",
        "sliceName": "protocol",
        "short": "Studien-/Pfadprotokoll (PlanDefinition), aus dem der Zeitpunkt stammt",
        "min": 0,
        "max": "1",
        "mustSupport": true
      },
      {
        "id": "Extension.extension:protocol.extension",
        "path": "Extension.extension.extension",
        "max": "0"
      },
      {
        "id": "Extension.extension:protocol.url",
        "path": "Extension.extension.url",
        "fixedUri": "protocol"
      },
      {
        "id": "Extension.extension:protocol.value[x]",
        "path": "Extension.extension.value[x]",
        "type": [
          {
            "code": "canonical",
            "targetProfile": [
              "http://hl7.org/fhir/StructureDefinition/PlanDefinition"
            ]
          }
        ]
      },
      {
        "id": "Extension.extension:protocolPosition",
        "path": "Extension.extension",
        "sliceName": "protocolPosition",
        "short": "Protokollposition: Visitencode = action.id/code der PlanDefinition",
        "min": 0,
        "max": "1",
        "mustSupport": true
      },
      {
        "id": "Extension.extension:protocolPosition.extension",
        "path": "Extension.extension.extension",
        "max": "0"
      },
      {
        "id": "Extension.extension:protocolPosition.url",
        "path": "Extension.extension.url",
        "fixedUri": "protocolPosition"
      },
      {
        "id": "Extension.extension:protocolPosition.value[x]",
        "path": "Extension.extension.value[x]",
        "type": [
          {
            "code": "Coding"
          }
        ]
      },
      {
        "id": "Extension.url",
        "path": "Extension.url",
        "fixedUri": "https://www.medizininformatik-initiative.de/fhir/ext/modul-pro/StructureDefinition/mii-ex-pro-erhebungskontext"
      },
      {
        "id": "Extension.value[x]",
        "path": "Extension.value[x]",
        "max": "0"
      }
    ]
  }
}
