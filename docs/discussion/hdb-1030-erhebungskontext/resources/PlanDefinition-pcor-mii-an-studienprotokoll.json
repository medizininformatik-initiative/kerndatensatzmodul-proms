      "url": "https://drks.de/search/de/trial/DRKS00038048"
    },
    {
      "type": "citation",
      "citation": "Integrating the Patient Perspective into Healthcare and Real-World Evidence: The Multi-site, Cross-Disease, Patient-Centered Outcomes Research Project in the Medical Informatics Initiative (PCOR-MII). J Healthc Inform Res 2025. doi:10.1007/s41666-025-00187-8"
    }
  ],
  "goal": [
    {
      "category": {
        "text": "Primaerer Endpunkt"
      },
      "description": {
        "text": "Symptomausprägung 18 Monate nach Entlassung (stationaer/teilstationaer) bzw. 18 Monate nach Befragungsbeginn (ambulant)"
      }
    },
    {
      "category": {
        "text": "Sekundaerer Endpunkt"
      },
      "description": {
        "text": "Verlauf 3 Jahre nach Entlassung bzw. Befragungsbeginn"
      }
    },
    {
      "category": {
        "text": "Tertiaerer Endpunkt"
      },
      "description": {
        "text": "Langzeitverlauf 6 Jahre nach Entlassung bzw. Befragungsbeginn"
      }
    }
  ],
