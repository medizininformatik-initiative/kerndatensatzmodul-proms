    },
    {
      "id": "test-cutoff-severe",
      "name": "Cut-off: Severe depression (score 20)",
      "description": "Total Score = 20 → Severity: Severe (20-27), PROMIS T-Score = 71.5",
      "action": [
        {
          "operation": {
            "type": { "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes", "code": "create" },
            "resource": "QuestionnaireResponse",
