    {
      "id": "test-mixed-answers",
      "name": "Mixed answers (realistic patient response)",
      "description": "Q1=2, Q2=1, Q3=2, Q4=3, Q5=1, Q6=0, Q7=1, Q8=2, Q9=0 → Total = 12, PROMIS T-Score = 62.3",
      "action": [
        {
          "operation": {
            "type": { "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes", "code": "create" },
