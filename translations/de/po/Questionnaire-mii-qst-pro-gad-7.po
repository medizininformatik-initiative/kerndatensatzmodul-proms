# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Over the last two weeks, how often have you been bothered by the following problems?"
msgstr "Wie oft fühlten Sie sich im Verlauf der letzten 2 Wochen durch die folgenden Beschwerden beeinträchtigt?"

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "1"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Feeling nervous, anxious, or on edge"
msgstr "Nervosität, Ängstlichkeit oder Anspannung"

# Coding.display
#: Coding.display
msgid "Not at all"
msgstr "Überhaupt nicht"

# Coding.display
#: Coding.display
msgid "Several days"
msgstr "An einzelnen Tagen"

# Coding.display
#: Coding.display
msgid "More than half the days"
msgstr "An mehr als der Hälfte der Tage"

# Coding.display
#: Coding.display
msgid "Nearly every day"
msgstr "Beinahe jeden Tag"

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "2"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Not being able to stop or control worrying"
msgstr "Nicht in der Lage sein, Sorgen zu stoppen oder zu kontrollieren"

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "3"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Worrying too much about different things"
msgstr "Übermäßige Sorgen bezüglich verschiedener Angelegenheiten"

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "4"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Trouble relaxing"
msgstr "Schwierigkeiten zu entspannen"

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "5"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Being so restless that it is hard to sit still"
msgstr "Rastlosigkeit, so dass Stillsitzen schwer fällt"

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "6"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Becoming easily annoyed or irritable"
msgstr "Schnelle Verärgerung oder Gereiztheit"

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "7"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Feeling afraid, as if something awful might happen"
msgstr "Gefühl der Angst, so als würde etwas Schlimmes passieren"

