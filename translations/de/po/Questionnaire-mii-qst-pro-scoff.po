# Questionnaire.item.text
#: Questionnaire.item.text
msgid "The following questions are about eating:"
msgstr "In den nächsten Fragen geht es um das Thema Essen:"

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "1"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Do you make yourself Sick because you feel uncomfortably full?"
msgstr "Übergeben Sie sich, wenn Sie sich unangenehm voll fühlen?"

# Coding.display
#: Coding.display
msgid "No"
msgstr ""

# Coding.display
#: Coding.display
msgid "Yes"
msgstr ""

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "2"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Do you worry you have lost Control over how much you eat?"
msgstr "Machen Sie sich Sorgen, weil Sie manchmal nicht mit dem Essen aufhören können?"

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "3"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Have you recently lost more than One stone in a 3 month period?"
msgstr "Haben Sie in der letzten Zeit mehr als 6 kg in 3 Monaten abgenommen?"

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "4"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Do you believe yourself to be Fat when others say you are too thin?"
msgstr "Finden Sie sich zu dick, während andere Sie zu dünn finden?"

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "5"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Would you say that Food dominates your life?"
msgstr "Würden Sie sagen, dass Essen Ihr Leben sehr beeinflusst?"

