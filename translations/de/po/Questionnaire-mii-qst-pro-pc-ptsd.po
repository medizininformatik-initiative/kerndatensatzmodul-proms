# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Haben Sie jemals in Ihrem Leben etwas so Beängstigendes, Schreckliches oder Erschütterndes erlebt, dass Sie in den letzten 4 Wochen …"
msgstr ""

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "1"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "… Albträume davon hatten oder daran dachten, obwohl Sie es nicht wollten?"
msgstr ""

# Coding.display
#: Coding.display
msgid "No"
msgstr ""

# Coding.display
#: Coding.display
msgid "Yes"
msgstr ""

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "2"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "… sich stark bemüht haben, nicht daran zu denken oder Situationen zu vermeiden, die Sie daran erinnern?"
msgstr ""

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "3"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "...ständig auf der Hut, wachsam oder schreckhaft waren?"
msgstr ""

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "4"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "...sich abgestumpft und teilnahmslos gegenüber anderen, bei ihren Aktivitäten oder in Ihrem Umfeld fühlten?"
msgstr ""

