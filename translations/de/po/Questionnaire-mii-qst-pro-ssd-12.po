# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Wie sehr wurden Sie in den letzten 7 Tagen durch folgende Beschwerden beeinträchtigt?"
msgstr ""

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "1"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Ich denke, dass meine körperlichen Beschwerden Anzeichen einer ernsthaften Erkrankung sind."
msgstr ""

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "2"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Ich mache mir große Sorgen um meine Gesundheit."
msgstr ""

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "3"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Meine gesundheitlichen Sorgen behindern mich im Alltag."
msgstr ""

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "4"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Ich bin von der Ernsthaftigkeit meiner körperlichen Beschwerden überzeugt."
msgstr ""

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "5"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Meine körperlichen Beschwerden machen mir Angst."
msgstr ""

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "6"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Meine körperlichen Beschwerden beschäftigen mich den größten Teil des Tages."
msgstr ""

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "7"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Andere sagen mir, dass meine körperlichen Beschwerden nicht schlimm sind."
msgstr ""

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "8"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Ich mache mir Sorgen, dass meine körperlichen Beschwerden niemals aufhören werden."
msgstr ""

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "9"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Die Sorgen um meine Gesundheit rauben mir Energie."
msgstr ""

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "10"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Ich denke, dass die Ärzte meine körperlichen Beschwerden nicht ernst nehmen."
msgstr ""

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "11"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Ich mache mir Sorgen auch in Zukunft durch meine körperlichen Beschwerden beeinträchtigt zu bleiben."
msgstr ""

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "12"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Durch meine körperlichen Beschwerden kann ich mich schlecht auf andere Dinge konzentrieren."
msgstr ""

