#: Questionnaire.item.prefix
msgid "28"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Has your physical condition or medical treatment caused you financial difficulties?"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "For the following questions please circle the number between 1 and 7 that best applies to you"
msgstr ""

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "29"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "How would you rate your overall health during the past week?"
msgstr ""

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "30"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "How would you rate your overall quality of life during the past week?"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Calculated Scores (0-100 scale)"
msgstr ""

# Expression.expression
#: Expression.expression
msgid "(1 - (((%resource.item.where(linkId.matches('^qlq-c30-q0[1-5]$')).answer.value.ordinal().sum()) / 5) - 1) / 3) * 100"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Physical Functioning Score"
msgstr ""

# Expression.expression
#: Expression.expression
msgid "(1 - (((%resource.item.where(linkId='qlq-c30-q06' or linkId='qlq-c30-q07').answer.value.ordinal().sum()) / 2) - 1) / 3) * 100"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Role Functioning Score"
msgstr ""

# Expression.expression
#: Expression.expression
msgid "(1 - (((%resource.item.where(linkId.matches('^qlq-c30-q2[1-4]$')).answer.value.ordinal().sum()) / 4) - 1) / 3) * 100"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Emotional Functioning Score"
msgstr ""

# Expression.expression
#: Expression.expression
msgid "(1 - (((%resource.item.where(linkId='qlq-c30-q20' or linkId='qlq-c30-q25').answer.value.ordinal().sum()) / 2) - 1) / 3) * 100"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Cognitive Functioning Score"
msgstr ""

# Expression.expression
#: Expression.expression
msgid "(1 - (((%resource.item.where(linkId='qlq-c30-q26' or linkId='qlq-c30-q27').answer.value.ordinal().sum()) / 2) - 1) / 3) * 100"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Social Functioning Score"
msgstr ""

# Expression.expression
#: Expression.expression
msgid "(((%resource.item.where(linkId='qlq-c30-q10' or linkId='qlq-c30-q12' or linkId='qlq-c30-q18').answer.value.ordinal().sum()) / 3) - 1) / 3) * 100"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Fatigue Score"
msgstr ""

# Expression.expression
#: Expression.expression
msgid "(((%resource.item.where(linkId='qlq-c30-q14' or linkId='qlq-c30-q15').answer.value.ordinal().sum()) / 2) - 1) / 3) * 100"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Nausea and Vomiting Score"
msgstr ""

# Expression.expression
#: Expression.expression
msgid "(((%resource.item.where(linkId='qlq-c30-q09' or linkId='qlq-c30-q19').answer.value.ordinal().sum()) / 2) - 1) / 3) * 100"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Pain Score"
msgstr ""

# Expression.expression
#: Expression.expression
msgid "((%resource.item.where(linkId='qlq-c30-q08').answer.value.ordinal() - 1) / 3) * 100"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Dyspnoea Score"
msgstr ""

# Expression.expression
#: Expression.expression
msgid "((%resource.item.where(linkId='qlq-c30-q11').answer.value.ordinal() - 1) / 3) * 100"
msgstr ""

