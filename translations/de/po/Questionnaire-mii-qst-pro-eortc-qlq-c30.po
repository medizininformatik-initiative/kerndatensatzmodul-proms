msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Appetite Loss Score"
msgstr ""

# Expression.expression
#: Expression.expression
msgid "((%resource.item.where(linkId='qlq-c30-q16').answer.value.ordinal() - 1) / 3) * 100"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Constipation Score"
msgstr ""

# Expression.expression
#: Expression.expression
msgid "((%resource.item.where(linkId='qlq-c30-q17').answer.value.ordinal() - 1) / 3) * 100"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Diarrhoea Score"
msgstr ""

# Expression.expression
#: Expression.expression
msgid "((%resource.item.where(linkId='qlq-c30-q28').answer.value.ordinal() - 1) / 3) * 100"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Financial Difficulties Score"
msgstr ""

# Expression.expression
#: Expression.expression
msgid "(((%resource.item.where(linkId='qlq-c30-q29' or linkId='qlq-c30-q30').answer.value.ordinal().sum()) / 2) - 1) / 6) * 100"
