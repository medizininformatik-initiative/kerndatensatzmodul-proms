# Questionnaire.item.text
#: Questionnaire.item.text
msgid "We are interested in some things about you and your health. Please answer all of the questions yourself by circling the number that best applies to you. There are no 'right' or 'wrong' answers. The information that you provide will remain strictly confidential."
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "During the past week:"
msgstr ""

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "1"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Do you have any trouble doing strenuous activities, like carrying a heavy shopping bag or a suitcase?"
msgstr ""

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "2"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Do you have any trouble taking a long walk?"
msgstr ""

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "3"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Do you have any trouble taking a short walk outside of the house?"
msgstr ""

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "4"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Do you need to stay in bed or a chair during the day?"
msgstr ""

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "5"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Do you need help with eating, dressing, washing yourself or using the toilet?"
msgstr ""

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "6"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Were you limited in doing either your work or other daily activities?"
msgstr ""

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "7"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Were you limited in pursuing your hobbies or other leisure time activities?"
msgstr ""

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "8"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Were you short of breath?"
msgstr ""

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "9"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Have you had pain?"
msgstr ""

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "10"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Did you need to rest?"
msgstr ""

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "11"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Have you had trouble sleeping?"
msgstr ""

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "12"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Have you felt weak?"
msgstr ""

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "13"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Have you lacked appetite?"
msgstr ""

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "14"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Have you felt nauseated?"
msgstr ""

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "15"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Have you vomited?"
msgstr ""

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "16"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Have you been constipated?"
msgstr ""

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "17"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Have you had diarrhea?"
msgstr ""

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "18"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Were you tired?"
msgstr ""

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "19"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Did pain interfere with your daily activities?"
msgstr ""

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "20"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Have you had difficulty in concentrating on things, like reading a newspaper or watching television?"
msgstr ""

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "21"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Did you feel tense?"
msgstr ""

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "22"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Did you worry?"
msgstr ""

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "23"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Did you feel irritable?"
msgstr ""

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "24"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Did you feel depressed?"
msgstr ""

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "25"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Have you had difficulty remembering things?"
msgstr ""

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "26"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Has your physical condition or medical treatment interfered with your family life?"
msgstr ""

# Questionnaire.item.prefix
#: Questionnaire.item.prefix
msgid "27"
msgstr ""

# Questionnaire.item.text
#: Questionnaire.item.text
msgid "Has your physical condition or medical treatment interfered with your social activities?"
