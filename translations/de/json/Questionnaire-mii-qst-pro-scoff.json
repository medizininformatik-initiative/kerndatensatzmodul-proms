    {
      "id" : "Questionnaire.item.text",
      "context" : "Questionnaire.item.text",
      "source" : "Do you make yourself Sick because you feel uncomfortably full?",
      "target" : "Übergeben Sie sich, wenn Sie sich unangenehm voll fühlen?"
