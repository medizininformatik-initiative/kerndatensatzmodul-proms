      "target" : null
    },
    {
      "id" : "Questionnaire.item.text",
      "context" : "Questionnaire.item.text",
      "source" : "Ich leiste Widerstand gegen immer wiederkehrende, unsinnige Gedanken oder Handlungen, auch wenn mir das nicht immer gelingt.",
