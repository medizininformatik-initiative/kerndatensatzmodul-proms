      "target" : null
    },
    {
      "id" : "ContactDetail.name",
      "context" : "ContactDetail.name",
      "source" : "Medizininformatik-Initiative",
      "target" : null
    },
    {
      "id" : "CodeSystem.description",
      "context" : "CodeSystem.description",
      "source" : "CodeSystem for the Depression Anxiety Stress Scales - Short Form (DASS-21) with answer codes, item codes, and multilingual support (English primary, German translations from Nilges & Essau 2015)",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.display",
      "context" : "CodeSystem.concept.display",
      "source" : "Did not apply to me at all",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.designation.value",
      "context" : "CodeSystem.concept.designation.value",
      "source" : "Traf gar nicht auf mich zu",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.display",
      "context" : "CodeSystem.concept.display",
      "source" : "Applied to me to some degree",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.designation.value",
      "context" : "CodeSystem.concept.designation.value",
      "source" : "Traf bis zu einem gewissen Grad auf mich zu",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.display",
      "context" : "CodeSystem.concept.display",
      "source" : "Applied to me to a considerable degree",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.designation.value",
      "context" : "CodeSystem.concept.designation.value",
      "source" : "Traf in beträchtlichem Maße auf mich zu",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.display",
      "context" : "CodeSystem.concept.display",
      "source" : "Applied to me very much",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.designation.value",
      "context" : "CodeSystem.concept.designation.value",
      "source" : "Traf sehr stark auf mich zu",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.display",
      "context" : "CodeSystem.concept.display",
      "source" : "I found it hard to wind down",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.designation.value",
      "context" : "CodeSystem.concept.designation.value",
      "source" : "Ich fand es schwer abzuschalten",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.display",
      "context" : "CodeSystem.concept.display",
      "source" : "I was aware of dryness of my mouth",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.designation.value",
      "context" : "CodeSystem.concept.designation.value",
      "source" : "Ich bemerkte Mundtrockenheit",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.display",
      "context" : "CodeSystem.concept.display",
      "source" : "I couldn't seem to experience any positive feeling at all",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.designation.value",
      "context" : "CodeSystem.concept.designation.value",
      "source" : "Ich konnte überhaupt keine positiven Gefühle mehr erleben",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.display",
      "context" : "CodeSystem.concept.display",
      "source" : "I experienced breathing difficulty",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.designation.value",
      "context" : "CodeSystem.concept.designation.value",
      "source" : "Ich hatte Atemschwierigkeiten",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.display",
      "context" : "CodeSystem.concept.display",
      "source" : "I found it difficult to work up the initiative to do things",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.designation.value",
      "context" : "CodeSystem.concept.designation.value",
      "source" : "Ich fand es schwierig, die Initiative zum Tun aufzubringen",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.display",
      "context" : "CodeSystem.concept.display",
      "source" : "I tended to over-react to situations",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.designation.value",
      "context" : "CodeSystem.concept.designation.value",
      "source" : "Ich neigte dazu, auf Situationen überzureagieren",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.display",
      "context" : "CodeSystem.concept.display",
      "source" : "I experienced trembling (e.g., in the hands)",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.designation.value",
      "context" : "CodeSystem.concept.designation.value",
      "source" : "Ich zitterte (z.B. an den Händen)",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.display",
      "context" : "CodeSystem.concept.display",
      "source" : "I felt that I was using a lot of nervous energy",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.designation.value",
      "context" : "CodeSystem.concept.designation.value",
      "source" : "Ich merkte, dass ich viel nervöse Energie verbrauchte",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.display",
      "context" : "CodeSystem.concept.display",
      "source" : "I was worried about situations in which I might panic and make a fool of myself",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.designation.value",
      "context" : "CodeSystem.concept.designation.value",
      "source" : "Ich machte mir Sorgen über Situationen, in denen ich in Panik geraten könnte",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.display",
      "context" : "CodeSystem.concept.display",
      "source" : "I felt that I had nothing to look forward to",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.designation.value",
      "context" : "CodeSystem.concept.designation.value",
      "source" : "Ich hatte das Gefühl, dass ich nichts erwarten konnte",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.display",
      "context" : "CodeSystem.concept.display",
      "source" : "I found myself getting agitated",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.designation.value",
      "context" : "CodeSystem.concept.designation.value",
      "source" : "Ich merkte, dass ich unruhig wurde",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.display",
      "context" : "CodeSystem.concept.display",
      "source" : "I found it difficult to relax",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.designation.value",
      "context" : "CodeSystem.concept.designation.value",
      "source" : "Ich fand es schwierig, mich zu entspannen",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.display",
      "context" : "CodeSystem.concept.display",
      "source" : "I felt down-hearted and blue",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.designation.value",
      "context" : "CodeSystem.concept.designation.value",
      "source" : "Ich fühlte mich niedergeschlagen und traurig",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.display",
      "context" : "CodeSystem.concept.display",
      "source" : "I was intolerant of anything that kept me from getting on with what I was doing",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.designation.value",
      "context" : "CodeSystem.concept.designation.value",
      "source" : "Ich war ungeduldig, wenn ich aufgehalten wurde",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.display",
      "context" : "CodeSystem.concept.display",
      "source" : "I felt I was close to panic",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.designation.value",
      "context" : "CodeSystem.concept.designation.value",
      "source" : "Ich fühlte mich einer Panik nahe",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.display",
      "context" : "CodeSystem.concept.display",
      "source" : "I was unable to become enthusiastic about anything",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.designation.value",
      "context" : "CodeSystem.concept.designation.value",
      "source" : "Ich konnte mich für nichts begeistern",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.display",
      "context" : "CodeSystem.concept.display",
      "source" : "I felt I wasn't worth much as a person",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.designation.value",
      "context" : "CodeSystem.concept.designation.value",
      "source" : "Ich hatte das Gefühl, nicht viel wert zu sein",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.display",
      "context" : "CodeSystem.concept.display",
      "source" : "I felt that I was rather touchy",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.designation.value",
      "context" : "CodeSystem.concept.designation.value",
      "source" : "Ich merkte, dass ich ziemlich empfindlich war",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.display",
      "context" : "CodeSystem.concept.display",
      "source" : "I was aware of the action of my heart in the absence of physical exertion",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.designation.value",
      "context" : "CodeSystem.concept.designation.value",
      "source" : "Ich nahm meinen Herzschlag wahr, ohne körperlich aktiv zu sein",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.display",
      "context" : "CodeSystem.concept.display",
      "source" : "I felt scared without any good reason",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.designation.value",
      "context" : "CodeSystem.concept.designation.value",
      "source" : "Ich fürchtete mich ohne ersichtlichen Grund",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.display",
      "context" : "CodeSystem.concept.display",
      "source" : "I felt that life was meaningless",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.designation.value",
      "context" : "CodeSystem.concept.designation.value",
      "source" : "Ich fand das Leben sinnlos",
      "target" : null
    }]
  }]
}
