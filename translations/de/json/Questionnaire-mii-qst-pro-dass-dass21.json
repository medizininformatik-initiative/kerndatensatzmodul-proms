    {
      "id" : "Questionnaire.item.text",
      "context" : "Questionnaire.item.text",
      "source" : "I found it hard to wind down",
      "target" : "Ich fand es schwer abzuschalten"
    },
    {
      "id" : "Coding.display",
      "context" : "Coding.display",
      "source" : "Did not apply to me at all",
      "target" : "Traf gar nicht auf mich zu"
