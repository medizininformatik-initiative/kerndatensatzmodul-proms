      "source" : "20",
      "target" : null
    },
    {
      "id" : "Questionnaire.item.text",
      "context" : "Questionnaire.item.text",
      "source" : "I felt scared without any good reason",
      "target" : "Ich fürchtete mich ohne ersichtlichen Grund"
