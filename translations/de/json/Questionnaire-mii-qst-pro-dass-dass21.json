    {
      "id" : "Coding.display",
      "context" : "Coding.display",
      "source" : "Applied to me to some degree",
      "target" : "Traf bis zu einem gewissen Grad auf mich zu"
    },
    {
      "id" : "Coding.display",
      "context" : "Coding.display",
      "source" : "Applied to me to a considerable degree",
      "target" : "Traf in beträchtlichem Maße auf mich zu"
    },
    {
      "id" : "Coding.display",
      "context" : "Coding.display",
      "source" : "Applied to me very much",
      "target" : "Traf sehr stark auf mich zu"
    },
    {
      "id" : "Questionnaire.item.prefix",
      "context" : "Questionnaire.item.prefix",
      "source" : "2",
      "target" : null
    },
    {
      "id" : "Questionnaire.item.text",
      "context" : "Questionnaire.item.text",
      "source" : "I was aware of dryness of my mouth",
      "target" : "Ich bemerkte Mundtrockenheit"
    },
    {
      "id" : "Questionnaire.item.prefix",
      "context" : "Questionnaire.item.prefix",
      "source" : "3",
      "target" : null
    },
    {
      "id" : "Questionnaire.item.text",
      "context" : "Questionnaire.item.text",
      "source" : "I couldn't seem to experience any positive feeling at all",
      "target" : "Ich konnte überhaupt keine positiven Gefühle mehr erleben"
    },
    {
      "id" : "Questionnaire.item.prefix",
      "context" : "Questionnaire.item.prefix",
      "source" : "4",
      "target" : null
    },
    {
      "id" : "Questionnaire.item.text",
      "context" : "Questionnaire.item.text",
      "source" : "I experienced breathing difficulty",
      "target" : "Ich hatte Atemschwierigkeiten"
    },
    {
      "id" : "Questionnaire.item.prefix",
      "context" : "Questionnaire.item.prefix",
      "source" : "5",
      "target" : null
    },
    {
      "id" : "Questionnaire.item.text",
      "context" : "Questionnaire.item.text",
      "source" : "I found it difficult to work up the initiative to do things",
      "target" : "Ich fand es schwierig, die Initiative zum Tun aufzubringen"
    },
    {
      "id" : "Questionnaire.item.prefix",
      "context" : "Questionnaire.item.prefix",
      "source" : "6",
      "target" : null
    },
    {
      "id" : "Questionnaire.item.text",
      "context" : "Questionnaire.item.text",
      "source" : "I tended to over-react to situations",
      "target" : "Ich neigte dazu, auf Situationen überzureagieren"
    },
    {
      "id" : "Questionnaire.item.prefix",
      "context" : "Questionnaire.item.prefix",
      "source" : "7",
      "target" : null
    },
    {
      "id" : "Questionnaire.item.text",
      "context" : "Questionnaire.item.text",
      "source" : "I experienced trembling (e.g., in the hands)",
      "target" : "Ich zitterte (z.B. an den Händen)"
    },
    {
      "id" : "Questionnaire.item.prefix",
      "context" : "Questionnaire.item.prefix",
      "source" : "8",
      "target" : null
    },
    {
      "id" : "Questionnaire.item.text",
      "context" : "Questionnaire.item.text",
      "source" : "I felt that I was using a lot of nervous energy",
      "target" : "Ich merkte, dass ich viel nervöse Energie verbrauchte"
    },
    {
      "id" : "Questionnaire.item.prefix",
      "context" : "Questionnaire.item.prefix",
      "source" : "9",
      "target" : null
    },
    {
      "id" : "Questionnaire.item.text",
      "context" : "Questionnaire.item.text",
      "source" : "I was worried about situations in which I might panic and make a fool of myself",
      "target" : "Ich machte mir Sorgen über Situationen, in denen ich in Panik geraten könnte"
    },
    {
      "id" : "Questionnaire.item.prefix",
      "context" : "Questionnaire.item.prefix",
      "source" : "10",
      "target" : null
    },
    {
      "id" : "Questionnaire.item.text",
      "context" : "Questionnaire.item.text",
      "source" : "I felt that I had nothing to look forward to",
      "target" : "Ich hatte das Gefühl, dass ich nichts erwarten konnte"
    },
    {
      "id" : "Questionnaire.item.prefix",
      "context" : "Questionnaire.item.prefix",
      "source" : "11",
      "target" : null
    },
    {
      "id" : "Questionnaire.item.text",
      "context" : "Questionnaire.item.text",
      "source" : "I found myself getting agitated",
      "target" : "Ich merkte, dass ich unruhig wurde"
    },
    {
      "id" : "Questionnaire.item.prefix",
      "context" : "Questionnaire.item.prefix",
      "source" : "12",
      "target" : null
    },
    {
      "id" : "Questionnaire.item.text",
      "context" : "Questionnaire.item.text",
      "source" : "I found it difficult to relax",
      "target" : "Ich fand es schwierig, mich zu entspannen"
    },
    {
      "id" : "Questionnaire.item.prefix",
      "context" : "Questionnaire.item.prefix",
      "source" : "13",
      "target" : null
    },
    {
      "id" : "Questionnaire.item.text",
      "context" : "Questionnaire.item.text",
      "source" : "I felt down-hearted and blue",
      "target" : "Ich fühlte mich niedergeschlagen und traurig"
    },
    {
      "id" : "Questionnaire.item.prefix",
      "context" : "Questionnaire.item.prefix",
      "source" : "14",
      "target" : null
    },
    {
      "id" : "Questionnaire.item.text",
      "context" : "Questionnaire.item.text",
      "source" : "I was intolerant of anything that kept me from getting on with what I was doing",
      "target" : "Ich war ungeduldig, wenn ich aufgehalten wurde"
    },
    {
      "id" : "Questionnaire.item.prefix",
      "context" : "Questionnaire.item.prefix",
      "source" : "15",
      "target" : null
    },
    {
      "id" : "Questionnaire.item.text",
      "context" : "Questionnaire.item.text",
      "source" : "I felt I was close to panic",
      "target" : "Ich fühlte mich einer Panik nahe"
    },
    {
      "id" : "Questionnaire.item.prefix",
      "context" : "Questionnaire.item.prefix",
      "source" : "16",
      "target" : null
    },
    {
      "id" : "Questionnaire.item.text",
      "context" : "Questionnaire.item.text",
      "source" : "I was unable to become enthusiastic about anything",
      "target" : "Ich konnte mich für nichts begeistern"
    },
    {
      "id" : "Questionnaire.item.prefix",
      "context" : "Questionnaire.item.prefix",
      "source" : "17",
      "target" : null
    },
    {
      "id" : "Questionnaire.item.text",
      "context" : "Questionnaire.item.text",
      "source" : "I felt I wasn't worth much as a person",
      "target" : "Ich hatte das Gefühl, nicht viel wert zu sein"
    },
    {
      "id" : "Questionnaire.item.prefix",
      "context" : "Questionnaire.item.prefix",
      "source" : "18",
      "target" : null
    },
    {
      "id" : "Questionnaire.item.text",
      "context" : "Questionnaire.item.text",
      "source" : "I felt that I was rather touchy",
      "target" : "Ich merkte, dass ich ziemlich empfindlich war"
    },
    {
      "id" : "Questionnaire.item.prefix",
      "context" : "Questionnaire.item.prefix",
      "source" : "19",
      "target" : null
    },
    {
      "id" : "Questionnaire.item.text",
      "context" : "Questionnaire.item.text",
      "source" : "I was aware of the action of my heart in the absence of physical exertion",
      "target" : "Ich nahm meinen Herzschlag wahr, ohne körperlich aktiv zu sein"
    },
    {
      "id" : "Questionnaire.item.prefix",
