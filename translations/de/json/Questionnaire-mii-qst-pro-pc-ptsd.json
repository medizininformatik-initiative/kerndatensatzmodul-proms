      "target" : null
    },
    {
      "id" : "Questionnaire.item.text",
      "context" : "Questionnaire.item.text",
      "source" : "… Albträume davon hatten oder daran dachten, obwohl Sie es nicht wollten?",
      "target" : null
    },
    {
      "id" : "Coding.display",
      "context" : "Coding.display",
      "source" : "No",
      "target" : null
    },
