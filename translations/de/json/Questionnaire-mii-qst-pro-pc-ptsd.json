      "source" : "Yes",
      "target" : null
    },
    {
      "id" : "Questionnaire.item.prefix",
      "context" : "Questionnaire.item.prefix",
      "source" : "2",
      "target" : null
    },
    {
      "id" : "Questionnaire.item.text",
      "context" : "Questionnaire.item.text",
      "source" : "… sich stark bemüht haben, nicht daran zu denken oder Situationen zu vermeiden, die Sie daran erinnern?",
      "target" : null
    },
    {
      "id" : "Questionnaire.item.prefix",
      "context" : "Questionnaire.item.prefix",
      "source" : "3",
      "target" : null
    },
    {
      "id" : "Questionnaire.item.text",
      "context" : "Questionnaire.item.text",
      "source" : "...ständig auf der Hut, wachsam oder schreckhaft waren?",
      "target" : null
    },
    {
      "id" : "Questionnaire.item.prefix",
      "context" : "Questionnaire.item.prefix",
      "source" : "4",
      "target" : null
    },
    {
      "id" : "Questionnaire.item.text",
      "context" : "Questionnaire.item.text",
      "source" : "...sich abgestumpft und teilnahmslos gegenüber anderen, bei ihren Aktivitäten oder in Ihrem Umfeld fühlten?",
