<?xml version="1.0" ?>

<xliff xmlns="urn:oasis:names:tc:xliff:document:2.0" version="2.0">
  <file source-language="en" target-language="de" id="Questionnaire-mii-qst-pro-pc-ptsd" original="Resource Questionnaire-mii-qst-pro-pc-ptsd" datatype="KEYVALUEJSON">
    <body>
      <trans-unit id="Questionnaire-mii-qst-pro-pc-ptsd" resname="Expression.expression">
             <notes>
               <note id="n1">Expression.expression</note>
             </notes>
        <source>%resource.item.where(linkId.matches('^pc-ptsd-q0[1-4]$')).answer.value.ordinal().sum()</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-pc-ptsd" resname="Questionnaire.title">
             <notes>
               <note id="n1">Questionnaire.title</note>
             </notes>
        <source>MII QST PRO PC-PTSD</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-pc-ptsd" resname="Questionnaire.publisher">
             <notes>
               <note id="n1">Questionnaire.publisher</note>
             </notes>
        <source>NUM-DIZ</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-pc-ptsd" resname="ContactDetail.name">
             <notes>
               <note id="n1">ContactDetail.name</note>
             </notes>
        <source>NUM-DIZ</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-pc-ptsd" resname="Questionnaire.description">
             <notes>
               <note id="n1">Questionnaire.description</note>
             </notes>
        <source>PC-PTSD — Primary Care PTSD Screen, four-item screening questionnaire for posttraumatic stress disorder (Prins et al. 2003; German: Schäfer &amp; Schulze 2010)</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-pc-ptsd" resname="Questionnaire.copyright">
             <notes>
               <note id="n1">Questionnaire.copyright</note>
             </notes>
        <source>PC-PTSD © Prins A, et al. 2003; deutsche Fassung Schäfer I, Schulze C, 2010. Freely available — Lizenz-Status: frei verfügbar (Tier A).</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-pc-ptsd" resname="Coding.display">
             <notes>
               <note id="n1">Coding.display</note>
             </notes>
        <source>PC-PTSD (Primary Care PTSD Screen)</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-pc-ptsd" resname="Questionnaire.item.text">
             <notes>
               <note id="n1">Questionnaire.item.text</note>
             </notes>
        <source>Haben Sie jemals in Ihrem Leben etwas so Beängstigendes, Schreckliches oder Erschütterndes erlebt, dass Sie in den letzten 4 Wochen …</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-pc-ptsd" resname="Questionnaire.item.prefix">
             <notes>
               <note id="n1">Questionnaire.item.prefix</note>
             </notes>
        <source>1</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-pc-ptsd" resname="Questionnaire.item.text">
             <notes>
               <note id="n1">Questionnaire.item.text</note>
             </notes>
        <source>… Albträume davon hatten oder daran dachten, obwohl Sie es nicht wollten?</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-pc-ptsd" resname="Coding.display">
             <notes>
               <note id="n1">Coding.display</note>
             </notes>
        <source>No</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-pc-ptsd" resname="Coding.display">
             <notes>
               <note id="n1">Coding.display</note>
             </notes>
        <source>Yes</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-pc-ptsd" resname="Questionnaire.item.prefix">
             <notes>
               <note id="n1">Questionnaire.item.prefix</note>
             </notes>
        <source>2</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-pc-ptsd" resname="Questionnaire.item.text">
             <notes>
               <note id="n1">Questionnaire.item.text</note>
             </notes>
        <source>… sich stark bemüht haben, nicht daran zu denken oder Situationen zu vermeiden, die Sie daran erinnern?</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-pc-ptsd" resname="Questionnaire.item.prefix">
             <notes>
               <note id="n1">Questionnaire.item.prefix</note>
             </notes>
        <source>3</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-pc-ptsd" resname="Questionnaire.item.text">
             <notes>
               <note id="n1">Questionnaire.item.text</note>
             </notes>
        <source>...ständig auf der Hut, wachsam oder schreckhaft waren?</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-pc-ptsd" resname="Questionnaire.item.prefix">
             <notes>
               <note id="n1">Questionnaire.item.prefix</note>
             </notes>
        <source>4</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-pc-ptsd" resname="Questionnaire.item.text">
             <notes>
               <note id="n1">Questionnaire.item.text</note>
             </notes>
        <source>...sich abgestumpft und teilnahmslos gegenüber anderen, bei ihren Aktivitäten oder in Ihrem Umfeld fühlten?</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-pc-ptsd" resname="Expression.expression">
             <notes>
               <note id="n1">Expression.expression</note>
             </notes>
        <source>%pcPtsdSum</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-pc-ptsd" resname="Coding.display">
             <notes>
               <note id="n1">Coding.display</note>
             </notes>
        <source>PC-PTSD Total Score (0-4)</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-pc-ptsd" resname="Questionnaire.item.prefix">
             <notes>
               <note id="n1">Questionnaire.item.prefix</note>
             </notes>
        <source>Score</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-pc-ptsd" resname="Questionnaire.item.text">
             <notes>
               <note id="n1">Questionnaire.item.text</note>
             </notes>
        <source>PC-PTSD Summenwert (0-4)</source>
        <target></target>
      </trans-unit>
    </body>
