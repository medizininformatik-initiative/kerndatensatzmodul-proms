<?xml version="1.0" ?>

<xliff xmlns="urn:oasis:names:tc:xliff:document:2.0" version="2.0">
  <file source-language="en" target-language="de" id="CodeSystem-mii-cs-pro-dass-21" original="Resource CodeSystem-mii-cs-pro-dass-21" datatype="KEYVALUEJSON">
    <body>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.name">
             <notes>
               <note id="n1">CodeSystem.name</note>
             </notes>
        <source>MII_CS_PRO_DASS_21</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.title">
             <notes>
               <note id="n1">CodeSystem.title</note>
             </notes>
        <source>MII CS PRO DASS-21 Response Scale and Item Codes</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.publisher">
             <notes>
               <note id="n1">CodeSystem.publisher</note>
             </notes>
        <source>Medizininformatik-Initiative</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="ContactDetail.name">
             <notes>
               <note id="n1">ContactDetail.name</note>
             </notes>
        <source>Medizininformatik-Initiative</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.description">
             <notes>
               <note id="n1">CodeSystem.description</note>
             </notes>
        <source>CodeSystem for the Depression Anxiety Stress Scales - Short Form (DASS-21) with answer codes, item codes, and multilingual support (English primary, German translations from Nilges &amp; Essau 2015)</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.display">
             <notes>
               <note id="n1">CodeSystem.concept.display</note>
             </notes>
        <source>Did not apply to me at all</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.designation.value">
             <notes>
               <note id="n1">CodeSystem.concept.designation.value</note>
             </notes>
        <source>Traf gar nicht auf mich zu</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.display">
             <notes>
               <note id="n1">CodeSystem.concept.display</note>
             </notes>
        <source>Applied to me to some degree</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.designation.value">
             <notes>
               <note id="n1">CodeSystem.concept.designation.value</note>
             </notes>
        <source>Traf bis zu einem gewissen Grad auf mich zu</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.display">
             <notes>
               <note id="n1">CodeSystem.concept.display</note>
             </notes>
        <source>Applied to me to a considerable degree</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.designation.value">
             <notes>
               <note id="n1">CodeSystem.concept.designation.value</note>
             </notes>
        <source>Traf in beträchtlichem Maße auf mich zu</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.display">
             <notes>
               <note id="n1">CodeSystem.concept.display</note>
             </notes>
        <source>Applied to me very much</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.designation.value">
             <notes>
               <note id="n1">CodeSystem.concept.designation.value</note>
             </notes>
        <source>Traf sehr stark auf mich zu</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.display">
             <notes>
               <note id="n1">CodeSystem.concept.display</note>
             </notes>
        <source>I found it hard to wind down</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.designation.value">
             <notes>
               <note id="n1">CodeSystem.concept.designation.value</note>
             </notes>
        <source>Ich fand es schwer abzuschalten</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.display">
             <notes>
               <note id="n1">CodeSystem.concept.display</note>
             </notes>
        <source>I was aware of dryness of my mouth</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.designation.value">
             <notes>
               <note id="n1">CodeSystem.concept.designation.value</note>
             </notes>
        <source>Ich bemerkte Mundtrockenheit</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.display">
             <notes>
               <note id="n1">CodeSystem.concept.display</note>
             </notes>
        <source>I couldn't seem to experience any positive feeling at all</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.designation.value">
             <notes>
               <note id="n1">CodeSystem.concept.designation.value</note>
             </notes>
        <source>Ich konnte überhaupt keine positiven Gefühle mehr erleben</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.display">
             <notes>
               <note id="n1">CodeSystem.concept.display</note>
             </notes>
        <source>I experienced breathing difficulty</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.designation.value">
             <notes>
               <note id="n1">CodeSystem.concept.designation.value</note>
             </notes>
        <source>Ich hatte Atemschwierigkeiten</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.display">
             <notes>
               <note id="n1">CodeSystem.concept.display</note>
             </notes>
        <source>I found it difficult to work up the initiative to do things</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.designation.value">
             <notes>
               <note id="n1">CodeSystem.concept.designation.value</note>
             </notes>
        <source>Ich fand es schwierig, die Initiative zum Tun aufzubringen</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.display">
             <notes>
               <note id="n1">CodeSystem.concept.display</note>
             </notes>
        <source>I tended to over-react to situations</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.designation.value">
             <notes>
               <note id="n1">CodeSystem.concept.designation.value</note>
             </notes>
        <source>Ich neigte dazu, auf Situationen überzureagieren</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.display">
             <notes>
               <note id="n1">CodeSystem.concept.display</note>
             </notes>
        <source>I experienced trembling (e.g., in the hands)</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.designation.value">
             <notes>
               <note id="n1">CodeSystem.concept.designation.value</note>
             </notes>
        <source>Ich zitterte (z.B. an den Händen)</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.display">
             <notes>
               <note id="n1">CodeSystem.concept.display</note>
             </notes>
        <source>I felt that I was using a lot of nervous energy</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.designation.value">
             <notes>
               <note id="n1">CodeSystem.concept.designation.value</note>
             </notes>
        <source>Ich merkte, dass ich viel nervöse Energie verbrauchte</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.display">
             <notes>
               <note id="n1">CodeSystem.concept.display</note>
             </notes>
        <source>I was worried about situations in which I might panic and make a fool of myself</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.designation.value">
             <notes>
               <note id="n1">CodeSystem.concept.designation.value</note>
             </notes>
        <source>Ich machte mir Sorgen über Situationen, in denen ich in Panik geraten könnte</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.display">
             <notes>
               <note id="n1">CodeSystem.concept.display</note>
             </notes>
        <source>I felt that I had nothing to look forward to</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.designation.value">
             <notes>
               <note id="n1">CodeSystem.concept.designation.value</note>
             </notes>
        <source>Ich hatte das Gefühl, dass ich nichts erwarten konnte</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.display">
             <notes>
               <note id="n1">CodeSystem.concept.display</note>
             </notes>
        <source>I found myself getting agitated</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.designation.value">
             <notes>
               <note id="n1">CodeSystem.concept.designation.value</note>
             </notes>
        <source>Ich merkte, dass ich unruhig wurde</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.display">
             <notes>
               <note id="n1">CodeSystem.concept.display</note>
             </notes>
        <source>I found it difficult to relax</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.designation.value">
             <notes>
               <note id="n1">CodeSystem.concept.designation.value</note>
             </notes>
        <source>Ich fand es schwierig, mich zu entspannen</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.display">
             <notes>
               <note id="n1">CodeSystem.concept.display</note>
             </notes>
        <source>I felt down-hearted and blue</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.designation.value">
             <notes>
               <note id="n1">CodeSystem.concept.designation.value</note>
             </notes>
        <source>Ich fühlte mich niedergeschlagen und traurig</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.display">
             <notes>
               <note id="n1">CodeSystem.concept.display</note>
             </notes>
        <source>I was intolerant of anything that kept me from getting on with what I was doing</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.designation.value">
             <notes>
               <note id="n1">CodeSystem.concept.designation.value</note>
             </notes>
        <source>Ich war ungeduldig, wenn ich aufgehalten wurde</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.display">
             <notes>
               <note id="n1">CodeSystem.concept.display</note>
             </notes>
        <source>I felt I was close to panic</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.designation.value">
             <notes>
               <note id="n1">CodeSystem.concept.designation.value</note>
             </notes>
        <source>Ich fühlte mich einer Panik nahe</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.display">
             <notes>
               <note id="n1">CodeSystem.concept.display</note>
             </notes>
        <source>I was unable to become enthusiastic about anything</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.designation.value">
             <notes>
               <note id="n1">CodeSystem.concept.designation.value</note>
             </notes>
        <source>Ich konnte mich für nichts begeistern</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.display">
             <notes>
               <note id="n1">CodeSystem.concept.display</note>
             </notes>
        <source>I felt I wasn't worth much as a person</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.designation.value">
             <notes>
               <note id="n1">CodeSystem.concept.designation.value</note>
             </notes>
        <source>Ich hatte das Gefühl, nicht viel wert zu sein</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.display">
             <notes>
               <note id="n1">CodeSystem.concept.display</note>
             </notes>
        <source>I felt that I was rather touchy</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.designation.value">
             <notes>
               <note id="n1">CodeSystem.concept.designation.value</note>
             </notes>
        <source>Ich merkte, dass ich ziemlich empfindlich war</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.display">
             <notes>
               <note id="n1">CodeSystem.concept.display</note>
             </notes>
        <source>I was aware of the action of my heart in the absence of physical exertion</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.designation.value">
             <notes>
               <note id="n1">CodeSystem.concept.designation.value</note>
             </notes>
        <source>Ich nahm meinen Herzschlag wahr, ohne körperlich aktiv zu sein</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.display">
             <notes>
               <note id="n1">CodeSystem.concept.display</note>
             </notes>
        <source>I felt scared without any good reason</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.designation.value">
             <notes>
               <note id="n1">CodeSystem.concept.designation.value</note>
             </notes>
        <source>Ich fürchtete mich ohne ersichtlichen Grund</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.display">
             <notes>
               <note id="n1">CodeSystem.concept.display</note>
             </notes>
        <source>I felt that life was meaningless</source>
        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-mii-cs-pro-dass-21" resname="CodeSystem.concept.designation.value">
             <notes>
               <note id="n1">CodeSystem.concept.designation.value</note>
             </notes>
        <source>Ich fand das Leben sinnlos</source>
        <target></target>
      </trans-unit>
    </body>
  </file>
