<?xml version="1.0" ?>

<xliff xmlns="urn:oasis:names:tc:xliff:document:2.0" version="2.0">
  <file source-language="en" target-language="de" id="Questionnaire-mii-qst-pro-isr-z" original="Resource Questionnaire-mii-qst-pro-isr-z" datatype="KEYVALUEJSON">
    <body>
      <trans-unit id="Questionnaire-mii-qst-pro-isr-z" resname="Expression.expression">
             <notes>
               <note id="n1">Expression.expression</note>
             </notes>
        <source>%resource.item.where(linkId.matches('^isr-z-q0[1-3]$')).answer.value.ordinal().avg()</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-isr-z" resname="Questionnaire.title">
             <notes>
               <note id="n1">Questionnaire.title</note>
             </notes>
        <source>MII QST PRO ISR-Z</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-isr-z" resname="Questionnaire.publisher">
             <notes>
               <note id="n1">Questionnaire.publisher</note>
             </notes>
        <source>Medizininformatik-Initiative</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-isr-z" resname="ContactDetail.name">
             <notes>
               <note id="n1">ContactDetail.name</note>
             </notes>
        <source>Medizininformatik-Initiative</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-isr-z" resname="Questionnaire.description">
             <notes>
               <note id="n1">Questionnaire.description</note>
             </notes>
        <source>ISR-Z — Subskala Zwang (3 Items) des ICD-10-Symptom-Rating (Tritt et al. 2008); Skalenwert als Mittelwert, nicht Summe</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-isr-z" resname="Questionnaire.copyright">
             <notes>
               <note id="n1">Questionnaire.copyright</note>
             </notes>
        <source>ICD-10-Symptom-Rating (ISR) © Tritt, von Heymann, Zaudig, Zacharias, Söllner &amp; Loew 2008. Freely available — no permission required for reproduction, translation, display or use. Lizenz-Status: frei verfügbar (Tier A).</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-isr-z" resname="Coding.display">
             <notes>
               <note id="n1">Coding.display</note>
             </notes>
        <source>ISR-Z (ICD-10-Symptom-Rating, Subskala Zwang, Tritt et al. 2008)</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-isr-z" resname="Questionnaire.item.text">
             <notes>
               <note id="n1">Questionnaire.item.text</note>
             </notes>
        <source>Bitte geben Sie jetzt an, ob eine der nachfolgenden Beschwerden in den letzten zwei Wochen auf Sie selbst zutrifft:</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-isr-z" resname="Questionnaire.item.prefix">
             <notes>
               <note id="n1">Questionnaire.item.prefix</note>
             </notes>
        <source>1</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-isr-z" resname="Questionnaire.item.text">
             <notes>
               <note id="n1">Questionnaire.item.text</note>
             </notes>
        <source>Ich leide unter meinen ständig wiederkehrenden, sinnlosen Gedanken oder Handlungen, gegen die ich mich aber nicht wehren kann (z.B. Hände waschen).</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-isr-z" resname="Questionnaire.item.prefix">
             <notes>
               <note id="n1">Questionnaire.item.prefix</note>
             </notes>
        <source>2</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-isr-z" resname="Questionnaire.item.text">
             <notes>
               <note id="n1">Questionnaire.item.text</note>
             </notes>
        <source>Ich leiste Widerstand gegen immer wiederkehrende, unsinnige Gedanken oder Handlungen, auch wenn mir das nicht immer gelingt.</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-isr-z" resname="Questionnaire.item.prefix">
             <notes>
               <note id="n1">Questionnaire.item.prefix</note>
             </notes>
        <source>3</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-isr-z" resname="Questionnaire.item.text">
             <notes>
               <note id="n1">Questionnaire.item.text</note>
             </notes>
        <source>Ich leide unter quälenden, sinnlosen Gedanken oder Handlungen, die mein normales Leben beeinträchtigen.</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-isr-z" resname="Expression.expression">
             <notes>
               <note id="n1">Expression.expression</note>
             </notes>
        <source>%isrZMean</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-isr-z" resname="Coding.display">
             <notes>
               <note id="n1">Coding.display</note>
             </notes>
        <source>ISR-Z Skalenwert (Mittelwert 0-4)</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-isr-z" resname="Questionnaire.item.prefix">
             <notes>
               <note id="n1">Questionnaire.item.prefix</note>
             </notes>
        <source>Skalenwert</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-isr-z" resname="Questionnaire.item.text">
             <notes>
               <note id="n1">Questionnaire.item.text</note>
             </notes>
        <source>ISR-Z Skalenwert (Mittelwert der 3 Zwang-Items, Bereich 0-4)</source>
        <target></target>
      </trans-unit>
    </body>
