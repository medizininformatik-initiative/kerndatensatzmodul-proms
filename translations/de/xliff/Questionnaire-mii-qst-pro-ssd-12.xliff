      <trans-unit id="Questionnaire-mii-qst-pro-ssd-12" resname="Expression.expression">
             <notes>
               <note id="n1">Expression.expression</note>
             </notes>
        <source>%resource.item.where(linkId.matches('^ssd12-q(0[1-9]|1[0-2])$')).answer.value.ordinal().sum()</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-ssd-12" resname="Questionnaire.title">
             <notes>
               <note id="n1">Questionnaire.title</note>
             </notes>
        <source>MII QST PRO SSD-12</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-ssd-12" resname="Questionnaire.publisher">
             <notes>
               <note id="n1">Questionnaire.publisher</note>
             </notes>
        <source>NUM-DIZ</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-ssd-12" resname="ContactDetail.name">
             <notes>
               <note id="n1">ContactDetail.name</note>
             </notes>
        <source>NUM-DIZ</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-ssd-12" resname="Questionnaire.description">
             <notes>
               <note id="n1">Questionnaire.description</note>
             </notes>
        <source>SSD-12 — Somatic Symptom Disorder – B Criteria Scale (Toussaint et al. 2016/2017), 12-item German self-report scale</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-ssd-12" resname="Questionnaire.copyright">
             <notes>
               <note id="n1">Questionnaire.copyright</note>
             </notes>
        <source>SSD-12 © Toussaint, Löwe et al. Freely available for research and clinical use. Lizenz-Status: frei verfügbar (Tier A).</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-ssd-12" resname="Coding.display">
             <notes>
               <note id="n1">Coding.display</note>
             </notes>
        <source>SSD-12 (Somatic Symptom Disorder - B Criteria Scale, Toussaint et al.)</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-ssd-12" resname="Questionnaire.item.text">
             <notes>
               <note id="n1">Questionnaire.item.text</note>
             </notes>
        <source>Wie sehr wurden Sie in den letzten 7 Tagen durch folgende Beschwerden beeinträchtigt?</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-ssd-12" resname="Questionnaire.item.prefix">
             <notes>
               <note id="n1">Questionnaire.item.prefix</note>
             </notes>
        <source>1</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-ssd-12" resname="Questionnaire.item.text">
             <notes>
               <note id="n1">Questionnaire.item.text</note>
             </notes>
        <source>Ich denke, dass meine körperlichen Beschwerden Anzeichen einer ernsthaften Erkrankung sind.</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-ssd-12" resname="Questionnaire.item.prefix">
             <notes>
               <note id="n1">Questionnaire.item.prefix</note>
             </notes>
        <source>2</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-ssd-12" resname="Questionnaire.item.text">
             <notes>
               <note id="n1">Questionnaire.item.text</note>
             </notes>
        <source>Ich mache mir große Sorgen um meine Gesundheit.</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-ssd-12" resname="Questionnaire.item.prefix">
             <notes>
               <note id="n1">Questionnaire.item.prefix</note>
             </notes>
        <source>3</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-ssd-12" resname="Questionnaire.item.text">
             <notes>
               <note id="n1">Questionnaire.item.text</note>
             </notes>
        <source>Meine gesundheitlichen Sorgen behindern mich im Alltag.</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-ssd-12" resname="Questionnaire.item.prefix">
             <notes>
               <note id="n1">Questionnaire.item.prefix</note>
             </notes>
        <source>4</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-ssd-12" resname="Questionnaire.item.text">
             <notes>
               <note id="n1">Questionnaire.item.text</note>
             </notes>
        <source>Ich bin von der Ernsthaftigkeit meiner körperlichen Beschwerden überzeugt.</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-ssd-12" resname="Questionnaire.item.prefix">
             <notes>
               <note id="n1">Questionnaire.item.prefix</note>
             </notes>
        <source>5</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-ssd-12" resname="Questionnaire.item.text">
             <notes>
               <note id="n1">Questionnaire.item.text</note>
             </notes>
        <source>Meine körperlichen Beschwerden machen mir Angst.</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-ssd-12" resname="Questionnaire.item.prefix">
             <notes>
               <note id="n1">Questionnaire.item.prefix</note>
             </notes>
        <source>6</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-ssd-12" resname="Questionnaire.item.text">
             <notes>
               <note id="n1">Questionnaire.item.text</note>
             </notes>
        <source>Meine körperlichen Beschwerden beschäftigen mich den größten Teil des Tages.</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-ssd-12" resname="Questionnaire.item.prefix">
             <notes>
               <note id="n1">Questionnaire.item.prefix</note>
             </notes>
        <source>7</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-ssd-12" resname="Questionnaire.item.text">
             <notes>
               <note id="n1">Questionnaire.item.text</note>
             </notes>
        <source>Andere sagen mir, dass meine körperlichen Beschwerden nicht schlimm sind.</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-ssd-12" resname="Questionnaire.item.prefix">
             <notes>
               <note id="n1">Questionnaire.item.prefix</note>
             </notes>
        <source>8</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-ssd-12" resname="Questionnaire.item.text">
             <notes>
               <note id="n1">Questionnaire.item.text</note>
             </notes>
        <source>Ich mache mir Sorgen, dass meine körperlichen Beschwerden niemals aufhören werden.</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-ssd-12" resname="Questionnaire.item.prefix">
             <notes>
               <note id="n1">Questionnaire.item.prefix</note>
             </notes>
        <source>9</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-ssd-12" resname="Questionnaire.item.text">
             <notes>
               <note id="n1">Questionnaire.item.text</note>
             </notes>
        <source>Die Sorgen um meine Gesundheit rauben mir Energie.</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-ssd-12" resname="Questionnaire.item.prefix">
             <notes>
               <note id="n1">Questionnaire.item.prefix</note>
             </notes>
        <source>10</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-ssd-12" resname="Questionnaire.item.text">
             <notes>
               <note id="n1">Questionnaire.item.text</note>
             </notes>
        <source>Ich denke, dass die Ärzte meine körperlichen Beschwerden nicht ernst nehmen.</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-ssd-12" resname="Questionnaire.item.prefix">
             <notes>
               <note id="n1">Questionnaire.item.prefix</note>
             </notes>
        <source>11</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-ssd-12" resname="Questionnaire.item.text">
             <notes>
               <note id="n1">Questionnaire.item.text</note>
             </notes>
        <source>Ich mache mir Sorgen auch in Zukunft durch meine körperlichen Beschwerden beeinträchtigt zu bleiben.</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-ssd-12" resname="Questionnaire.item.prefix">
             <notes>
               <note id="n1">Questionnaire.item.prefix</note>
             </notes>
        <source>12</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-ssd-12" resname="Questionnaire.item.text">
             <notes>
               <note id="n1">Questionnaire.item.text</note>
             </notes>
        <source>Durch meine körperlichen Beschwerden kann ich mich schlecht auf andere Dinge konzentrieren.</source>
        <target></target>
      </trans-unit>
      <trans-unit id="Questionnaire-mii-qst-pro-ssd-12" resname="Expression.expression">
             <notes>
               <note id="n1">Expression.expression</note>
             </notes>
        <source>%ssd12Sum</source>
        <target></target>
      </trans-unit>
