        "extension": [
          {
            "extension": [
              {
                "url": "lang",
                "valueCode": "de"
              },
              {
                "url": "content",
                "valueString": "Empfinden Sie diese Anfälle als stark beeinträchtigend, und/oder haben Sie Angst vor erneuten Anfällen?"
              }
            ],
            "url": "http://hl7.org/fhir/StructureDefinition/translation"
          }
        ]
