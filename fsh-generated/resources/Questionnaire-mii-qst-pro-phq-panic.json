          ],
          "valueCoding": {
            "code": "373066001",
            "system": "http://snomed.info/sct",
            "display": "Yes"
          }
        }
      ],
      "linkId": "phq-phq3d",
      "type": "choice",
      "prefix": "d",
      "text": "Do these attacks bother you a lot or are you worried about having another attack?",
