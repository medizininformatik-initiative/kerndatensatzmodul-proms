  "item": [
    {
      "linkId": "phq-panic-intro",
      "type": "display",
      "text": "Questions about anxiety.",
      "_text": {
        "extension": [
          {
            "extension": [
              {
                "url": "lang",
                "valueCode": "de"
              },
              {
                "url": "content",
                "valueString": "Fragen zum Thema \"Angst\""
              }
            ],
            "url": "http://hl7.org/fhir/StructureDefinition/translation"
          }
        ]
      }
    },
    {
      "answerOption": [
        {
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/itemWeight",
              "valueDecimal": 0
            }
          ],
          "valueCoding": {
            "code": "373067005",
            "system": "http://snomed.info/sct",
            "display": "No"
          }
        },
        {
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/itemWeight",
              "valueDecimal": 1
            }
          ],
          "valueCoding": {
            "code": "373066001",
            "system": "http://snomed.info/sct",
            "display": "Yes"
          }
        }
      ],
      "linkId": "phq-phq3a",
      "type": "choice",
      "prefix": "a",
      "text": "In the last 4 weeks, have you had an anxiety attack — suddenly feeling fear or panic?",
      "_text": {
        "extension": [
          {
            "extension": [
              {
                "url": "lang",
                "valueCode": "de"
              },
              {
                "url": "content",
                "valueString": "Hatten Sie in den letzten 4 Wochen eine Angstattacke (plötzliches Gefühl der Furcht oder Panik?)"
              }
            ],
            "url": "http://hl7.org/fhir/StructureDefinition/translation"
          }
        ]
      },
      "required": true
    },
    {
      "enableWhen": [
        {
          "question": "phq-phq3a",
          "operator": "=",
          "answerCoding": {
            "code": "373066001",
            "system": "http://snomed.info/sct",
            "display": "Yes"
          }
        }
      ],
      "answerOption": [
        {
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/itemWeight",
              "valueDecimal": 0
            }
          ],
          "valueCoding": {
            "code": "373067005",
            "system": "http://snomed.info/sct",
            "display": "No"
