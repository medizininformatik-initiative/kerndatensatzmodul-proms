  "item": [
    {
      "linkId": "scoff-intro",
      "type": "display",
      "text": "In den nächsten Fragen geht es um das Thema Essen:",
      "_text": {
        "extension": [
          {
            "extension": [
              {
                "url": "lang",
                "valueCode": "en"
              },
              {
                "url": "content",
                "valueString": "The following questions are about eating:"
              }
            ],
            "url": "http://hl7.org/fhir/StructureDefinition/translation"
          }
        ]
      }
    },
    {
      "linkId": "scoff-q01",
      "type": "choice",
      "prefix": "1",
      "text": "Übergeben Sie sich, wenn Sie sich unangenehm voll fühlen?",
      "_text": {
        "extension": [
          {
            "extension": [
              {
                "url": "lang",
                "valueCode": "en"
              },
              {
                "url": "content",
                "valueString": "Do you make yourself Sick because you feel uncomfortably full?"
              }
            ],
            "url": "http://hl7.org/fhir/StructureDefinition/translation"
          }
        ]
      },
      "answerValueSet": "https://www.medizininformatik-initiative.de/fhir/ext/modul-pro/ValueSet/mii-vs-pro-yes-no-answers"
    },
    {
      "linkId": "scoff-q02",
      "type": "choice",
      "prefix": "2",
      "text": "Machen Sie sich Sorgen, weil Sie manchmal nicht mit dem Essen aufhören können?",
      "_text": {
        "extension": [
          {
            "extension": [
              {
                "url": "lang",
                "valueCode": "en"
              },
              {
                "url": "content",
                "valueString": "Do you worry you have lost Control over how much you eat?"
              }
            ],
            "url": "http://hl7.org/fhir/StructureDefinition/translation"
          }
        ]
      },
      "answerValueSet": "https://www.medizininformatik-initiative.de/fhir/ext/modul-pro/ValueSet/mii-vs-pro-yes-no-answers"
    },
    {
      "linkId": "scoff-q03",
      "type": "choice",
      "prefix": "3",
      "text": "Haben Sie in der letzten Zeit mehr als 6 kg in 3 Monaten abgenommen?",
      "_text": {
        "extension": [
          {
            "extension": [
              {
                "url": "lang",
                "valueCode": "en"
              },
              {
                "url": "content",
                "valueString": "Have you recently lost more than One stone (6.35 kg) in a 3 month period?"
              }
            ],
            "url": "http://hl7.org/fhir/StructureDefinition/translation"
          }
        ]
      },
      "answerValueSet": "https://www.medizininformatik-initiative.de/fhir/ext/modul-pro/ValueSet/mii-vs-pro-yes-no-answers"
    },
    {
      "linkId": "scoff-q04",
      "type": "choice",
      "prefix": "4",
      "text": "Finden Sie sich zu dick, während andere Sie zu dünn finden?",
      "_text": {
        "extension": [
          {
            "extension": [
              {
                "url": "lang",
                "valueCode": "en"
              },
              {
                "url": "content",
                "valueString": "Do you believe yourself to be Fat when others say you are too thin?"
              }
            ],
            "url": "http://hl7.org/fhir/StructureDefinition/translation"
          }
        ]
      },
      "answerValueSet": "https://www.medizininformatik-initiative.de/fhir/ext/modul-pro/ValueSet/mii-vs-pro-yes-no-answers"
    },
    {
      "linkId": "scoff-q05",
      "type": "choice",
      "prefix": "5",
      "text": "Würden Sie sagen, dass Essen Ihr Leben sehr beeinflusst?",
      "_text": {
        "extension": [
          {
            "extension": [
              {
                "url": "lang",
                "valueCode": "en"
              },
              {
                "url": "content",
                "valueString": "Would you say that Food dominates your life?"
              }
            ],
            "url": "http://hl7.org/fhir/StructureDefinition/translation"
          }
        ]
      },
      "answerValueSet": "https://www.medizininformatik-initiative.de/fhir/ext/modul-pro/ValueSet/mii-vs-pro-yes-no-answers"
    },
    {
      "code": [
        {
          "code": "scoff-total",
          "system": "https://www.medizininformatik-initiative.de/fhir/ext/modul-pro/CodeSystem/mii-cs-pro-score-catalogue",
